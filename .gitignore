# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Test and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Local case database: holds real user symptom data, never commit it.
data/dr_aishu.db
data/*.db
data/*.db-journal
# SQLite write-ahead sidecars. These carry the same patient data as the database
# and are recreated on open, so they must never be committed either.
data/*.db-shm
data/*.db-wal
data/*.sqlite*
# Consented image uploads kept for training: patient data, never commit it.
data/uploads/
# Trained model artefacts are large binaries and are retrained per host, so they
# stay out of git. The directory itself must exist in a fresh clone or the
# Dockerfile's COPY fails, hence the tracked .gitkeep.
data/models/*
!data/models/.gitkeep

# External datasets (hundreds of MB) and anything derived from them. Fetch with
# scripts/import_symptom_dataset.py rather than committing the raw file.
data/external/
data/training/mendeley_2023.jsonl
# Generated from the workbook by scripts/import_workbook_training.py, so it is
# reproducible rather than source. `seed.jsonl` stays committed: it is the
# hand-written bootstrap the workbook import is measured against.
data/training/workbook_2024.jsonl

# Environment. `.env.example` is a template of placeholders, not a secret, and
# the deployment tests read it; keep it tracked.
.env
.env.*
!.env.example

# Local run artefacts
server.log
*.log
nohup.out
