# Dr. Aishu — environment template.
# Copy to `.env` for local development: `cp .env.example .env`
# Never commit `.env`.

# ---- server -----------------------------------------------------------------
# Most PaaS providers set PORT for you. Local default is 8000.
PORT=8000

# ---- data -------------------------------------------------------------------
# Directory holding the SQLite case database and issued API keys.
# On hosts with a mounted volume, point this at the mount (e.g. /data).
# DR_AISHU_DATA_DIR=/data

# ---- API key access ---------------------------------------------------------
# "0" (default): requests without a key run under a tight per-IP demo key, so
#                the browser UI and the hosted demo work with no signup.
# "1":           a valid key is mandatory; unauthenticated calls get 401.
#                Use this when the instance is API-only.
DR_AISHU_REQUIRE_KEY=0

# A pinned, permanent API key (Pro tier). Useful for self-hosting, CI and demos,
# because it survives redeploys on hosts with an ephemeral filesystem.
# Generate one with:
#   python -c "import secrets; print('dra_' + secrets.token_urlsafe(32))"
# DR_AISHU_BOOTSTRAP_KEY=dra_replace_me
